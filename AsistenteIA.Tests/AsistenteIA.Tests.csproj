<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas unitarias de la lógica de AsistenteIA que no depende de MAUI.
    El proyecto de la app es .NET MAUI (Windows y Android) y no se puede referenciar desde un
    proyecto de pruebas net10.0, por eso se compilan aquí, enlazados, solo los archivos puros.
    Ejecutar desde la raíz del repositorio:  dotnet test AsistenteIA.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AsistenteIA\Services\AiService.Rules.cs" Link="Codigo\AiService.Rules.cs" />
    <Compile Include="..\AsistenteIA\Services\AiServiceException.cs" Link="Codigo\AiServiceException.cs" />
    <Compile Include="..\AsistenteIA\Models\AiProvider.cs" Link="Codigo\AiProvider.cs" />
    <Compile Include="..\AsistenteIA\Models\ChatModels.cs" Link="Codigo\ChatModels.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
