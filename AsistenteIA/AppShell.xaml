<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AsistenteIA.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AsistenteIA.Views"
    Title="AsistenteIA">

    <TabBar>
        <ShellContent Title="Inicio" Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Consultar" Route="chat" ContentTemplate="{DataTemplate views:ChatPage}" />
        <ShellContent Title="Historial" Route="history" ContentTemplate="{DataTemplate views:HistoryPage}" />
        <ShellContent Title="Configuración" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
