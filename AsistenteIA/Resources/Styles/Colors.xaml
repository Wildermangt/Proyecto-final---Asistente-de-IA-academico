<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta propia de AsistenteIA: verde azulado "tinta" (estudio, calma) con acento ámbar.
         Todos los pares texto/fondo cumplen contraste WCAG AA (4.5:1) en tema claro y oscuro.
         Android: ver también Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0F6E6A</Color>
    <Color x:Key="PrimaryDark">#5ED1C4</Color>
    <Color x:Key="PrimaryDarkText">#04201E</Color>
    <Color x:Key="Secondary">#DCEFEC</Color>
    <Color x:Key="SecondaryDarkText">#8FE0D6</Color>
    <Color x:Key="Tertiary">#0A4744</Color>
    <Color x:Key="Accent">#955A00</Color>
    <Color x:Key="AccentDark">#F2B544</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Ink">#132322</Color>
    <Color x:Key="OffBlack">#0F1517</Color>

    <Color x:Key="Gray100">#E2E7E5</Color>
    <Color x:Key="Gray200">#C9D1CF</Color>
    <Color x:Key="Gray300">#A9B4B2</Color>
    <Color x:Key="Gray400">#8A9694</Color>
    <Color x:Key="Gray500">#66726F</Color>
    <Color x:Key="Gray600">#3C4745</Color>
    <Color x:Key="Gray900">#1C2524</Color>
    <Color x:Key="Gray950">#121918</Color>

    <!-- Superficies -->
    <Color x:Key="BackgroundLight">#F6F7F5</Color>
    <Color x:Key="BackgroundDark">#0F1517</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#182124</Color>
    <Color x:Key="StrokeLight">#E2E7E5</Color>
    <Color x:Key="StrokeDark">#2A3639</Color>

    <!-- Burbujas del chat -->
    <Color x:Key="UserBubbleLight">#0F6E6A</Color>
    <Color x:Key="UserBubbleDark">#1D5753</Color>

    <!-- Estados -->
    <Color x:Key="WarningBackground">#FFF4D6</Color>
    <Color x:Key="WarningText">#5C4300</Color>
    <Color x:Key="WarningBackgroundDark">#3A2E10</Color>
    <Color x:Key="WarningTextDark">#F5D78A</Color>
    <Color x:Key="Danger">#B3261E</Color>
    <Color x:Key="DangerDark">#F2B8B5</Color>
    <Color x:Key="Success">#166B33</Color>
    <Color x:Key="SuccessDark">#7DD99A</Color>
    <Color x:Key="SuccessBackground">#E3F4E8</Color>
    <Color x:Key="SuccessBackgroundDark">#173322</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
