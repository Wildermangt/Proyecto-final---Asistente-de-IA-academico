<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AsistenteIA.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
             xmlns:fx="clr-namespace:AsistenteIA.Behaviors"
             x:DataType="vm:HomeViewModel"
             Title="Inicio">

    <ContentPage.Resources>
        <!-- Tarjeta de acceso rápido: ícono, título y descripción; toda la tarjeta es táctil -->
        <Style TargetType="Border" x:Key="QuickTile" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="96" />
            <Setter Property="fx:Animations.Entrance" Value="Up" />
            <Setter Property="fx:Animations.PressEffect" Value="True" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="1000">

            <!-- Encabezado -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" fx:Animations.Entrance="Fade">
                <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource UserBubbleDark}}">
                    <Label Text="&#xe65f;" FontFamily="Icons" FontSize="30" TextColor="{StaticResource White}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="AsistenteIA" Style="{StaticResource PageTitle}" AutomationId="HomeTitle" />
                    <Label Text="Tu asistente académico con inteligencia artificial" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Grid>

            <Label Style="{StaticResource Caption}" LineBreakMode="WordWrap"
                   Text="Envía tus consultas a un modelo de inteligencia artificial mediante una API REST, revisa la respuesta y guarda el historial en tu dispositivo." />

            <!-- Aviso cuando no hay clave configurada -->
            <Border Style="{StaticResource WarningCard}" IsVisible="{Binding HasKey, Converter={StaticResource InvertedBool}}"
                    AutomationId="HomeNoKeyWarning">
                <Label Style="{StaticResource WarningLabel}"
                       Text="Aún no hay una clave de API configurada. Ve a Configuración para registrarla antes de consultar." />
            </Border>

            <Label Text="Accesos rápidos" Style="{StaticResource SectionTitle}" />
            <!-- Cuadrícula 2 x 2: cabe en un teléfono y en escritorio sin recortar las tarjetas -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Style="{StaticResource QuickTile}" AutomationId="HomeGoChat" fx:Animations.Delay="60"
                        SemanticProperties.Description="Consultar IA" SemanticProperties.Hint="Abre la pantalla para escribir una consulta">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//chat" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xe0bf;" Style="{StaticResource Icon}" FontSize="26" />
                        <Label Text="Consultar IA" FontFamily="InterSemiBold" />
                        <Label Text="Escribe una pregunta y recibe la respuesta" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource QuickTile}" AutomationId="HomeGoHistory" fx:Animations.Delay="130"
                        SemanticProperties.Description="Ver historial">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//history" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xe889;" Style="{StaticResource Icon}" FontSize="26" />
                        <Label Text="Historial" FontFamily="InterSemiBold" />
                        <Label Text="{Binding HistorySummary}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="WordWrap"
                               AutomationId="HomeHistorySummary" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource QuickTile}" AutomationId="HomeGoTemplates" fx:Animations.Delay="200"
                        SemanticProperties.Description="Plantillas">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="templates" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xe745;" Style="{StaticResource Icon}" FontSize="26" />
                        <Label Text="Plantillas" FontFamily="InterSemiBold" />
                        <Label Text="Crea y edita prompts académicos" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource QuickTile}" AutomationId="HomeGoSettings" fx:Animations.Delay="270"
                        SemanticProperties.Description="Configuración">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//settings" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xe8b8;" Style="{StaticResource Icon}" FontSize="26" />
                        <Label Text="Configuración" FontFamily="InterSemiBold" />
                        <Label Text="Clave, proveedor, modelo y acerca de" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" fx:Animations.Entrance="Up" fx:Animations.Delay="340">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Recomendaciones de uso" Style="{StaticResource SectionTitle}" />
                    <Label LineBreakMode="WordWrap" Text="• Escribe consultas claras y específicas; usa una plantilla para orientar la respuesta." />
                    <Label LineBreakMode="WordWrap" Text="• La IA puede equivocarse o inventar datos: verifica siempre con fuentes confiables." />
                    <Label LineBreakMode="WordWrap" Text="• No ingreses datos personales, contraseñas ni información confidencial." />
                    <Label LineBreakMode="WordWrap" Text="• Usa las respuestas como apoyo al aprendizaje, no como sustituto de tu propio trabajo." />
                    <Label LineBreakMode="WordWrap" Text="• Marca como verificadas las respuestas que contrastaste, desde el detalle del historial." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
