<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AsistenteIA.Views.TemplatesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
             xmlns:models="clr-namespace:AsistenteIA.Models"
             x:DataType="vm:TemplatesViewModel"
             Title="Plantillas">
    <!-- La lista ocupa el espacio libre y tiene su propio desplazamiento; el formulario queda siempre visible. -->
    <Grid Padding="20,12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Label Text="Plantillas de prompts" Style="{StaticResource PageTitle}" />
        <Label Grid.Row="1" Style="{StaticResource Caption}" LineBreakMode="WordWrap"
               Text="Seleccione una plantilla para editarla. Use {consulta} donde debe ir el texto que escribe el usuario." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <CollectionView ItemsSource="{Binding Templates}" SelectionMode="Single" AutomationId="TemplatesList"
                            SelectedItem="{Binding SelectedTemplate}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PromptTemplate">
                        <Grid Padding="10,8" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" AutomationId="TemplatesFormTitle" />
                <FlexLayout Wrap="Wrap" Margin="-5,0">
                    <Entry Placeholder="Nombre" Text="{Binding EditName}" AutomationId="TemplatesNameEntry"
                           Margin="5,0,5,6" FlexLayout.Basis="220" FlexLayout.Grow="1"
                           SemanticProperties.Description="Nombre de la plantilla" />
                    <Picker Title="Categoría" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding EditCategory}"
                            Margin="5,0,5,6" FlexLayout.Basis="180" FlexLayout.Grow="1"
                            AutomationId="TemplatesCategoryPicker" />
                </FlexLayout>
                <Editor Placeholder="Texto de la plantilla con {consulta}" Text="{Binding EditText}"
                        AutoSize="TextChanges" MinimumHeightRequest="70" MaximumHeightRequest="140"
                        AutomationId="TemplatesTextEditor" SemanticProperties.Description="Texto de la plantilla" />
                <FlexLayout Wrap="Wrap" AlignItems="Center">
                    <Button Text="Guardar" Margin="0,0,10,6" Command="{Binding SaveCommand}" AutomationId="TemplatesSave" />
                    <Button Text="Nueva" Margin="0,0,10,6" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NewCommand}" AutomationId="TemplatesNew" />
                    <Button Text="Eliminar" Margin="0,0,10,6" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" AutomationId="TemplatesDelete" />
                    <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" AutomationId="TemplatesStatus"
                           VerticalOptions="Center" />
                </FlexLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
